#!/bin/sh
#SBATCH --job-name={name}
#SBATCH --account=ctb-emuller
#SBATCH --cpus-per-task=4
#SBATCH --ntasks=1
#SBATCH --time={cpu_time}
#SBATCH --mem=4g
#SBATCH --chdir={workdir}
#SBATCH --output=sim_{log}.log

source {env}

# Handle both old simwriter.py format and new evaluator format
python {run} {param_args} --fastforward={fastforward}{param_hash_arg}{individual_id_arg}{generation_arg}
